@using AlGhaniMedicalStore.Models
@{
    ViewData["Title"] = "Billing";
    var restore = ViewBag.CartJson as string ?? "[]";
    var error = ViewBag.Error as string;
    int payVal = ViewBag.Payment is int pv ? pv : 1;
    decimal discVal = ViewBag.Discount is decimal dv ? dv : 0m;
}

<h2>Billing</h2>

@if (!string.IsNullOrEmpty(error))
{
<div class="alert alert-danger">@error</div>
}

<div class="mb-3">
    <input id="search" class="form-control form-control-lg" placeholder="Type medicine name or salt, then press Enter to add the first one" autocomplete="off" autofocus />
</div>

<div class="table-responsive mb-4" id="resultsBox" style="display:none">
    <table class="table table-hover table-sm mb-0">
        <thead>
            <tr>
                <th>Medicine</th>
                <th>Salt</th>
                <th>Rack</th>
                <th class="text-end">Stock (tablets)</th>
                <th>Nearest expiry</th>
                <th class="text-end">Box</th>
                <th class="text-end">Strip</th>
                <th class="text-end">Tablet</th>
            </tr>
        </thead>
        <tbody id="results"></tbody>
    </table>
</div>

<form asp-action="Checkout" method="post" id="billForm">
    <input type="hidden" name="cartJson" id="cartJson" />

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th style="width:130px">Unit</th>
                    <th style="width:110px">Qty</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cartBody"></tbody>
        </table>
    </div>

    <div class="row justify-content-end">
        <div class="col-md-4">
            <div class="d-flex justify-content-between mb-2">
                <span>Sub total</span><strong id="subTotal">0.00</strong>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span>Discount</span>
                <input name="discount" id="discount" type="number" min="0" step="0.01"
                       value="@discVal.ToString("0.##")" class="form-control form-control-sm text-end" style="width:120px" />
            </div>
            <div class="d-flex justify-content-between mb-3">
                <span class="fs-5">Total</span><strong class="fs-5" id="grandTotal">0.00</strong>
            </div>
            <div class="mb-3">
                <select name="paymentType" class="form-select">
                    <option value="1" selected="@(payVal == 1)">Cash</option>
                    <option value="2" selected="@(payVal == 2)">Online</option>
                </select>
            </div>
            <button class="btn btn-success w-100 btn-lg">Save and print bill</button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        const alertDays = @ViewBag.AlertDays;
        let cart = [];
        try { cart = JSON.parse(@Html.Raw(Json.Serialize(restore))); } catch { cart = []; }
        if (!Array.isArray(cart)) cart = [];

        let results = [];
        let timer;

        const el = id => document.getElementById(id);
        const money = n => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');

        function perUnit(it) {
            return it.unit === 1 ? it.stripsPerBox * it.tabletsPerStrip
                 : it.unit === 2 ? it.tabletsPerStrip : 1;
        }
        function priceOf(it) {
            return it.unit === 1 ? it.boxPrice : it.unit === 2 ? it.stripPrice : it.tabletPrice;
        }

        // Search
        el('search').addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(runSearch, 200);
        });

        el('search').addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (results.length > 0) addToCart(results[0]);
            }
        });

        async function runSearch() {
            const q = el('search').value.trim();
            if (q.length < 2) { results = []; renderResults(); return; }
            const res = await fetch('/Billing/Search?q=' + encodeURIComponent(q));
            if (q !== el('search').value.trim()) return;
            results = await res.json();
            renderResults();
        }

        function renderResults() {
            el('resultsBox').style.display = results.length ? '' : 'none';
            el('results').innerHTML = results.map((m, i) => {
                let exp = '-';
                let cls = '';
                if (m.expiry) {
                    const days = (new Date(m.expiry) - new Date()) / 86400000;
                    exp = new Date(m.expiry).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                    if (days <= alertDays) cls = 'text-danger fw-bold';
                }
                const out = m.stock < 1;
                return `<tr data-i="${i}" style="cursor:pointer" class="${out ? 'text-muted' : ''}">
                    <td>${esc(m.name)}</td>
                    <td>${esc(m.generic)}</td>
                    <td>${esc(m.rack)}</td>
                    <td class="text-end">${out ? 'Out of stock' : m.stock}</td>
                    <td class="${cls}">${exp}</td>
                    <td class="text-end">${money(m.boxPrice)}</td>
                    <td class="text-end">${money(m.stripPrice)}</td>
                    <td class="text-end">${money(m.tabletPrice)}</td>
                </tr>`;
            }).join('');
        }

        el('results').addEventListener('click', e => {
            const tr = e.target.closest('tr');
            if (tr) addToCart(results[parseInt(tr.dataset.i)]);
        });

        function addToCart(m) {
            if (!m || m.stock < 1) return;
            const ex = cart.find(c => c.medicineId === m.id);
            if (ex) {
                ex.quantity += 1;
                ex.stock = m.stock;
            } else {
                cart.push({
                    medicineId: m.id, name: m.name, unit: 2, quantity: 1,
                    stripsPerBox: m.stripsPerBox, tabletsPerStrip: m.tabletsPerStrip,
                    boxPrice: m.boxPrice, stripPrice: m.stripPrice, tabletPrice: m.tabletPrice,
                    stock: m.stock
                });
            }
            el('search').value = '';
            results = [];
            renderResults();
            renderCart();
            el('search').focus();
        }

        // Cart
        function renderCart() {
            el('cartBody').innerHTML = cart.map((c, i) => `
                <tr>
                    <td>${esc(c.name)}<div class="small text-danger warn"></div></td>
                    <td>
                        <select class="form-select form-select-sm unit">
                            <option value="1" ${c.unit === 1 ? 'selected' : ''}>Box</option>
                            <option value="2" ${c.unit === 2 ? 'selected' : ''}>Strip</option>
                            <option value="3" ${c.unit === 3 ? 'selected' : ''}>Tablet</option>
                        </select>
                    </td>
                    <td><input type="number" min="1" class="form-control form-control-sm qty" value="${c.quantity}" /></td>
                    <td class="text-end price"></td>
                    <td class="text-end line"></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger remove">X</button></td>
                </tr>`).join('');
            refresh();
        }

        function refresh() {
            const need = {};
            cart.forEach(c => {
                need[c.medicineId] = (need[c.medicineId] || 0) + c.quantity * perUnit(c);
            });

            let sub = 0;
            [...el('cartBody').rows].forEach((r, i) => {
                const c = cart[i];
                const p = priceOf(c);
                const t = c.quantity * p;
                sub += t;
                r.querySelector('.price').textContent = money(p);
                r.querySelector('.line').textContent = money(t);
                r.querySelector('.warn').textContent =
                    p <= 0 ? 'Price not set'
                    : need[c.medicineId] > c.stock ? 'Only ' + c.stock + ' tablets in stock' : '';
            });

            const disc = parseFloat(el('discount').value) || 0;
            el('subTotal').textContent = money(sub);
            el('grandTotal').textContent = money(Math.max(sub - disc, 0));
        }

        el('cartBody').addEventListener('input', e => {
            if (e.target.classList.contains('qty')) {
                const i = e.target.closest('tr').rowIndex - 1;
                cart[i].quantity = parseInt(e.target.value) || 0;
                refresh();
            }
        });

        el('cartBody').addEventListener('change', e => {
            if (e.target.classList.contains('unit')) {
                const i = e.target.closest('tr').rowIndex - 1;
                cart[i].unit = parseInt(e.target.value);
                refresh();
            }
        });

        el('cartBody').addEventListener('click', e => {
            if (e.target.classList.contains('remove')) {
                const i = e.target.closest('tr').rowIndex - 1;
                cart.splice(i, 1);
                renderCart();
            }
        });

        el('discount').addEventListener('input', refresh);

        // Enter must not submit the bill by mistake
        el('billForm').addEventListener('keydown', e => {
            if (e.key === 'Enter' && e.target.tagName === 'INPUT') e.preventDefault();
        });

        el('billForm').addEventListener('submit', e => {
            if (cart.length === 0 || cart.some(c => !(c.quantity >= 1))) {
                e.preventDefault();
                alert('Add medicines with quantity 1 or more.');
                return;
            }
            el('cartJson').value = JSON.stringify(cart);
        });

        renderCart();
    </script>
}