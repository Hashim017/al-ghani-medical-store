@using AlGhaniMedicalStore.ViewModels
@model PurchaseReturnVm
@{
    ViewData["Title"] = "Return to supplier";
    var batches = (List<BatchOpt>)ViewBag.Batches;
}

<h2>Return to supplier</h2>

<form method="post" class="panel" style="max-width:640px">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Supplier</label>
        <select asp-for="SupplierId" asp-items="(SelectList)ViewBag.Suppliers" class="form-select">
            <option value="0">Select supplier</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Batch</label>
        <select asp-for="BatchId" class="form-select" id="batch">
            <option value="0">Select batch</option>
            @foreach (var b in batches)
            {
            <option value="@b.Id" data-qty="@b.Qty">@b.Text</option>
            }
        </select>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Tablets to return</label>
            <div class="input-group">
                <input name="Tablets" id="tabs" type="number" min="1" class="form-control"
                       placeholder="0" value="@(Model.Tablets == 0 ? "" : Model.Tablets.ToString())" />
                <button type="button" class="btn btn-outline-primary" id="all">All</button>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Credit from supplier</label>
            <input name="Credit" type="number" min="0" step="0.01" class="form-control"
                   placeholder="0" value="@(Model.Credit == 0 ? "" : Model.Credit.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Reason</label>
        <input asp-for="Reason" class="form-control" placeholder="Expired, damaged, wrong item" />
    </div>

    <button class="btn btn-primary">Save return</button>
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>

@section Scripts {
    <script>
        const sel = document.getElementById('batch');
        const tabs = document.getElementById('tabs');
        document.getElementById('all').addEventListener('click', () => {
            tabs.value = sel.selectedOptions[0]?.dataset.qty || '';
        });
    </script>
}