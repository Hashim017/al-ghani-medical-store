@using System.Globalization
@model AlGhaniMedicalStore.Models.Medicine
@{
    var inv = CultureInfo.InvariantCulture;
    string Dec(decimal v) => v == 0 ? "" : v.ToString("0.##", inv);
    string Num(int v, bool blankWhenOne = false) =>
        (v == 0 || (blankWhenOne && v == 1 && Model.Id == 0)) ? "" : v.ToString();
}

<form method="post" style="max-width:720px">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsActive" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row">
        <div class="col-md-8 mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Example: Panadol 500mg" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Form" class="form-label">Type</label>
            <select asp-for="Form" class="form-select">
                <option value="">Select</option>
                <option>Tablet</option>
                <option>Capsule</option>
                <option>Syrup</option>
                <option>Injection</option>
                <option>Cream</option>
                <option>Drops</option>
                <option>Cosmetic</option>
                <option>Other</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="CategoryId" class="form-label">Category</label>
            <select asp-for="CategoryId" asp-items="(SelectList)ViewBag.Categories" class="form-select">
                <option value="">None</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CompanyId" class="form-label">Company</label>
            <select asp-for="CompanyId" asp-items="(SelectList)ViewBag.Companies" class="form-select">
                <option value="">None</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="GenericId" class="form-label">Generic (Salt)</label>
            <select asp-for="GenericId" asp-items="(SelectList)ViewBag.Generics" class="form-select">
                <option value="">None</option>
            </select>
        </div>
    </div>

    <div class="panel mb-3">
        <div class="form-check form-switch mb-3">
            <input asp-for="UsesStrips" class="form-check-input" />
            <label asp-for="UsesStrips" class="form-check-label">
                Sold in strips. Keep this on for tablets and capsules. Turn it off for syrups, creams and cosmetics.
            </label>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label" id="lblPerBox">Strips in 1 box</label>
                <input name="StripsPerBox" type="number" min="1" class="form-control"
                       placeholder="1" value="@Num(Model.StripsPerBox, true)" />
            </div>
            <div class="col-md-6 mb-3 strip-only">
                <label class="form-label">Tablets in 1 strip</label>
                <input name="TabletsPerStrip" type="number" min="1" class="form-control"
                       placeholder="1" value="@Num(Model.TabletsPerStrip, true)" />
            </div>
        </div>

        <h6>Sale prices</h6>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Box price</label>
                <input name="BoxPrice" type="number" step="0.01" min="0" class="form-control"
                       placeholder="0" value="@Dec(Model.BoxPrice)" />
            </div>
            <div class="col-md-4 mb-3 strip-only">
                <label class="form-label">Strip price</label>
                <input name="StripPrice" type="number" step="0.01" min="0" class="form-control"
                       placeholder="0" value="@Dec(Model.StripPrice)" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label" id="lblTabletPrice">Tablet price</label>
                <input name="TabletPrice" type="number" step="0.01" min="0" class="form-control"
                       placeholder="0" value="@Dec(Model.TabletPrice)" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Rack location</label>
            <input asp-for="RackLocation" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Low stock level, in tablets or pieces</label>
            <input name="ReorderLevel" type="number" min="0" class="form-control"
                   placeholder="0" value="@Num(Model.ReorderLevel)" />
        </div>
    </div>

    <button class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>

<script>
    (function () {
        const sw = document.getElementById('UsesStrips');
        const type = document.getElementById('Form');
        const stripOnly = document.querySelectorAll('.strip-only');
        const lblBox = document.getElementById('lblPerBox');
        const lblPrice = document.getElementById('lblTabletPrice');

        function apply() {
            const on = sw.checked;
            stripOnly.forEach(e => e.style.display = on ? '' : 'none');
            lblBox.textContent = on ? 'Strips in 1 box' : 'Pieces in 1 box, leave empty if not sold by box';
            lblPrice.textContent = on ? 'Tablet price' : 'Price of 1 piece';
        }

        sw.addEventListener('change', apply);
        type.addEventListener('change', () => {
            if (type.value === 'Tablet' || type.value === 'Capsule') sw.checked = true;
            else if (type.value) sw.checked = false;
            apply();
        });
        apply();
    })();
</script>