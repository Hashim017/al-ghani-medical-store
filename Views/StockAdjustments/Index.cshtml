@model List<AlGhaniMedicalStore.Models.StockAdjustment>
    @{
    ViewData["Title"] = "Stock adjustments";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Stock adjustments</h2>
        <a asp-action="Create" class="btn btn-primary">New adjustment</a>
    </div>

    <table class="table">
        <thead>
            <tr><th>Date</th><th>Medicine</th><th>Batch</th><th>Reason</th><th class="text-end">Change</th><th>Note</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
        {
            <tr>
                <td>@a.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                <td>@a.Batch?.Medicine?.Name</td>
                <td>@a.Batch?.BatchNumber</td>
                <td>@a.Reason</td>
                <td class="text-end fw-bold @(a.QuantityChange < 0 ? "text-danger" : "text-success")">@a.QuantityChange</td>
                <td>@a.Note</td>
            </tr>
        }
        </tbody>
    </table>
