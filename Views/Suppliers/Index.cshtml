@model List<AlGhaniMedicalStore.Models.Supplier>
    @{
    ViewData["Title"] = "Suppliers";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Suppliers</h2>
        <a asp-action="Create" class="btn btn-primary">Add Supplier</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr><th>Name</th><th>Phone</th><th>Address</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Phone</td>
                <td>@s.Address</td>
                <td>
                    @if (s.IsActive) { <span class="badge bg-success">Active</span> }
                    else { <span class="badge bg-secondary">Off</span> }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="Toggle" asp-route-id="@s.Id" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-secondary">@(s.IsActive ? "Turn off" : "Turn on")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
