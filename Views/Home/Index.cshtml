@model AlGhaniMedicalStore.ViewModels.DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    var t = Model.Today;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Today</h2>
    <a asp-controller="Billing" asp-action="Index" class="btn btn-success btn-lg">New bill</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Sales</div>
                <div class="fs-4 fw-bold">@t.SalesTotal.ToString("N2")</div>
                <div class="small text-muted">@t.Bills bills</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Cash</div>
                <div class="fs-4 fw-bold">@t.Cash.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Online</div>
                <div class="fs-4 fw-bold">@t.Online.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">Profit</div>
                <div class="fs-4 fw-bold">@t.Profit.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="Reports" asp-action="Expiry" class="text-decoration-none">
            <div class="card border-danger h-100">
                <div class="card-body">
                    <div class="text-muted">Already expired, still in stock</div>
                    <div class="fs-3 fw-bold text-danger">@Model.ExpiredCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Reports" asp-action="Expiry" class="text-decoration-none">
            <div class="card border-warning h-100">
                <div class="card-body">
                    <div class="text-muted">Expiring in @Model.AlertDays days</div>
                    <div class="fs-3 fw-bold text-warning">@Model.ExpiringCount</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-controller="Reports" asp-action="LowStock" class="text-decoration-none">
            <div class="card border-primary h-100">
                <div class="card-body">
                    <div class="text-muted">Low stock</div>
                    <div class="fs-3 fw-bold text-primary">@Model.LowStockCount</div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <h5>Expiring soon</h5>
        @if (Model.Expiring.Count == 0)
        {
        <p class="text-muted">Nothing is expiring soon.</p>
        }
        else
        {
        <table class="table table-sm table-striped">
            <thead><tr><th>Medicine</th><th>Batch</th><th>Expiry</th><th class="text-end">Tablets</th></tr></thead>
            <tbody>
                @foreach (var r in Model.Expiring)
                    {
                <tr>
                    <td>@r.MedicineName</td>
                    <td>@r.BatchNumber</td>
                    <td>@r.ExpiryDate.ToString("dd MMM yyyy") <span class="text-muted small">@r.DaysLeft d</span></td>
                    <td class="text-end">@r.QuantityLeft</td>
                </tr>
                    }
            </tbody>
        </table>
        <a asp-controller="Reports" asp-action="Expiry">See all</a>
        }
    </div>

    <div class="col-lg-6">
        <h5>Low stock</h5>
        @if (Model.LowStock.Count == 0)
        {
        <p class="text-muted">All medicines are above their low stock level.</p>
        }
        else
        {
        <table class="table table-sm table-striped">
            <thead><tr><th>Medicine</th><th>Rack</th><th class="text-end">Stock</th><th class="text-end">Level</th></tr></thead>
            <tbody>
                @foreach (var r in Model.LowStock)
                    {
                <tr>
                    <td>@r.Name</td>
                    <td>@r.Rack</td>
                    <td class="text-end text-danger fw-bold">@r.Stock</td>
                    <td class="text-end">@r.ReorderLevel</td>
                </tr>
                    }
            </tbody>
        </table>
        <a asp-controller="Reports" asp-action="LowStock">See all</a>
        }
    </div>
</div>