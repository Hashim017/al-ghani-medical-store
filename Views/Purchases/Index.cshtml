@model List<AlGhaniMedicalStore.Models.Purchase>
    @{
    ViewData["Title"] = "Purchases";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Purchases</h2>
        <a asp-action="Create" class="btn btn-primary">New Purchase</a>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Date</th>
                <th>Supplier</th>
                <th>Bill no</th>
                <th>Payment</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
        {
            <tr>
                <td>@p.PurchaseDate.ToString("dd MMM yyyy")</td>
                <td>@p.Supplier?.Name</td>
                <td>@p.BillNumber</td>
                <td>@p.PaymentType</td>
                <td class="text-end">@p.Total.ToString("N2")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
