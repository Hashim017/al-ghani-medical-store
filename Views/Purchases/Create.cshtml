@using AlGhaniMedicalStore.Models
@using AlGhaniMedicalStore.ViewModels
@model PurchaseCreateVm
@{
    ViewData["Title"] = "New Purchase";
}

<h2>New Purchase</h2>

<form asp-action="Create" method="post" id="stockForm">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row mb-3">
        <div class="col-md-3">
            <label asp-for="SupplierId" class="form-label">Supplier</label>
            <select asp-for="SupplierId" asp-items="(SelectList)ViewBag.Suppliers" class="form-select">
                <option value="0">Select supplier</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="BillNumber" class="form-label">Supplier bill no</label>
            <input asp-for="BillNumber" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="PurchaseDate" class="form-label">Date</label>
            <input asp-for="PurchaseDate" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="PaymentType" class="form-label">Payment</label>
            <select asp-for="PaymentType" asp-items="Html.GetEnumSelectList<PaymentType>()" class="form-select"></select>
        </div>
    </div>

    <partial name="_StockGrid" model="Model.Lines" />

    <button class="btn btn-primary">Save purchase</button>
    <a asp-action="Index" class="btn btn-light">Cancel</a>
</form>