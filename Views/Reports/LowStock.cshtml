@model List<AlGhaniMedicalStore.ViewModels.LowStockRow>
    @{
    ViewData["Title"] = "Low stock";
    }

    <h2>Low stock</h2>
    <p class="text-muted">Stock counts only batches that are not expired.</p>

    @if (Model.Count == 0)
{
    <p>All medicines are above their low stock level.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Medicine</th><th>Rack</th><th class="text-end">Stock (tablets)</th><th class="text-end">Low stock level</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
            <tr>
                <td>@r.Name</td>
                <td>@r.Rack</td>
                <td class="text-end @(r.Stock == 0 ? "text-danger fw-bold" : "")">@r.Stock</td>
                <td class="text-end">@r.ReorderLevel</td>
            </tr>
            }
        </tbody>
    </table>
}
