@model AlGhaniMedicalStore.ViewModels.DailyReportVm
@{
    ViewData["Title"] = "Daily report";
}

<h2>Daily report</h2>

<form method="get" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="date" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary">Show</button>
    </div>
</form>

<h5>@Model.Date.ToString("dddd, dd MMM yyyy")</h5>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Bills</div><div class="fs-4 fw-bold">@Model.Bills</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Sales total</div><div class="fs-4 fw-bold">@Model.SalesTotal.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Discount given</div><div class="fs-4 fw-bold">@Model.Discount.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Profit</div><div class="fs-4 fw-bold">@Model.Profit.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <h5>Sales by payment</h5>
        <table class="table table-sm">
            <tr><td>Cash</td><td class="text-end">@Model.Cash.ToString("N2")</td></tr>
            <tr><td>Online</td><td class="text-end">@Model.Online.ToString("N2")</td></tr>
            <tr class="fw-bold"><td>Total</td><td class="text-end">@Model.SalesTotal.ToString("N2")</td></tr>
        </table>
    </div>
    <div class="col-md-6">
        <h5>Purchases by payment</h5>
        <table class="table table-sm">
            <tr><td>Cash</td><td class="text-end">@Model.PurchaseCash.ToString("N2")</td></tr>
            <tr><td>Online</td><td class="text-end">@Model.PurchaseOnline.ToString("N2")</td></tr>
            <tr class="fw-bold"><td>Total</td><td class="text-end">@Model.PurchaseTotal.ToString("N2")</td></tr>
        </table>
    </div>
</div>

<div class="alert alert-info" style="max-width:500px">
    Cash in hand change for the day: <strong>@Model.NetCash.ToString("N2")</strong><br />
    <span class="small">Cash sales minus cash purchases.</span>
</div>

<h5>Top selling medicines</h5>
@if (Model.Top.Count == 0)
{
<p class="text-muted">No sales on this day.</p>
}
else
{
<table class="table table-sm table-striped">
    <thead><tr><th>Medicine</th><th class="text-end">Tablets sold</th><th class="text-end">Amount</th></tr></thead>
    <tbody>
        @foreach (var i in Model.Top)
            {
        <tr>
            <td>@i.Name</td>
            <td class="text-end">@i.Tablets</td>
            <td class="text-end">@i.Amount.ToString("N2")</td>
        </tr>
            }
    </tbody>
</table>
}