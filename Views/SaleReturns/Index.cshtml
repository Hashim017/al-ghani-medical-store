@model List<AlGhaniMedicalStore.Models.SaleReturn>
    @{
    ViewData["Title"] = "Customer returns";
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Customer returns</h2>
        <a asp-action="Create" class="btn btn-primary">New return</a>
    </div>

    <table class="table">
        <thead>
            <tr><th>Date</th><th>Bill no</th><th class="text-end">Lines</th><th>Reason</th><th class="text-end">Refund</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
        {
            <tr>
                <td>@r.ReturnDate.ToString("dd MMM yyyy hh:mm tt")</td>
                <td><a asp-controller="Billing" asp-action="Receipt" asp-route-id="@r.SaleId">@r.SaleId</a></td>
                <td class="text-end">@r.Items.Count</td>
                <td>@r.Reason</td>
                <td class="text-end">@r.RefundTotal.ToString("N2")</td>
            </tr>
        }
        </tbody>
    </table>
